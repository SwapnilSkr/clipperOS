{
  "name": "clipper-os-server",
  "version": "1.0.0",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "vision:install": "bun run scripts/install-vision.ts",
    "whisper:install": "bun run scripts/install-whisper.ts",
    "ytdlp:install": "bun run scripts/install-ytdlp.ts",
    "ytdlp:update": "bun run scripts/update-ytdlp.ts",
    "validate:mining": "bun run scripts/validate-mining.ts",
    "reframe:validate": "bun run scripts/validate-reframe.ts",
    "captions:validate": "bun run scripts/validate-captions.ts",
    "video-effects:validate": "bun run scripts/validate-video-effects.ts",
    "soundtrack:validate": "bun run scripts/validate-soundtrack.ts",
    "outro:validate": "bun run scripts/validate-outro.ts",
    "share-copy:validate": "bun run scripts/validate-share-copy.ts",
    "audio:generate": "bun run scripts/generate-audio-library.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@elysiajs/cors": "^1.4.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.219",
    "bullmq": "^5.79.2",
    "elysia": "latest",
    "fluent-ffmpeg": "^2.1.3",
    "mongoose": "^9.0.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
