# Copy to `.env` and fill in. Bun loads `.env` automatically.
# This file is gitignored — never commit real credentials.

# =============================================================================
# Required
# =============================================================================
PORT=8787
HOST=localhost
NODE_ENV=development

# MongoDB — local mongod, or an Atlas URI.
MONGODB_URI=mongodb://localhost:27017/clipperOS
# Optional: tried automatically if MONGODB_URI is unreachable.
# MONGODB_URI_FALLBACK=mongodb+srv://user:pass@cluster.mongodb.net/clipperOS

REDIS_URL=redis://localhost:6379

# https://openrouter.ai/keys — mining + smart reframe
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# Object storage (optional)
# =============================================================================
# OUTPUT_STORAGE=s3 requires a bucket + credentials.
# Set OUTPUT_STORAGE=local to serve renders straight from the API instead.
OUTPUT_STORAGE=local
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFRONT_URL=
# Objects are namespaced under this prefix so a shared bucket stays clean.
S3_PREFIX=clipperOS/

# =============================================================================
# Models
# =============================================================================
# MODEL_TIER=cheap            # cheap | value | premium
# Mining model. Chosen for latency: ~0.6s/call vs ~3.5s for deepseek-v4-flash.
LLM_MODEL=google/gemini-2.5-flash-lite
# Hard ceiling on mining output per chunk — stops some models rambling.
LLM_MAX_OUTPUT_TOKENS=2000
# Frame understanding for smart reframing.
VISION_MODEL=google/gemini-2.5-flash

# =============================================================================
# Media
# =============================================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

# Render parallelism. CPU-bound — keep low on a laptop.
QUEUE_CONCURRENCY=3

# YouTube video downloads need a JavaScript runtime. Caption fetching does not,
# so ingest works even without one — only rendering would fail.
# Set to "" to omit the flag entirely.
YT_DLP_JS_RUNTIME=node

# Storage (resolved to absolute paths at runtime)
STORAGE_PATH=./storage
PROCESSING_PATH=./storage/processing
UPLOADS_PATH=./storage/uploads
OUTPUT_PATH=./storage/output
MEDIA_PATH=./storage/media

MAX_FILE_SIZE_MB=4096
CAPTION_CHUNK_WORDS=3

# =============================================================================
# Whisper fallback (optional)
# =============================================================================
# Only needed for sources with NO captions at all. Run `bun run whisper:install`
# first, then set this to true.
WHISPER_ALIGNMENT_ENABLED=false
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=./storage/whisper/ggml-base.en.bin

# =============================================================================
# Vision (optional local OpenCV stack)
# =============================================================================
# Powers speaker-aware reframing (faces + mouth motion, cut-aware) and burned-in
# text / watermark removal. Run `bun run vision:install` once to create the venv
# and fetch the YuNet model, then set this to true and restart.
#
# Both features DEGRADE rather than fail: with this off, or with the venv
# missing, reframing falls back to the vision model and then a centre crop, and
# cleanup falls back to ffmpeg delogo.
VISION_REFRAME_ENABLED=false
VISION_PYTHON_PATH=./storage/vision/venv/bin/python3
VISION_SCRIPT_PATH=./python/reframe_analyze.py
VISION_CLEANUP_SCRIPT_PATH=./python/cleanup_inpaint.py
VISION_FACE_MODEL_PATH=./storage/vision/models/face_detection_yunet_2023mar.onnx
# Creator mode: the person matte behind titles (onnxruntime + RobustVideoMatting,
# also installed by `bun run vision:install`). Titles render in front without it.
VISION_MATTE_SCRIPT_PATH=./python/person_matte.py
VISION_MATTE_MODEL_PATH=./storage/vision/models/rvm_mobilenetv3_fp32.onnx

# =============================================================================
# Creator mode
# =============================================================================
# The AI Director writes a whole beat plan in one call, so it defaults to a
# stronger model than LLM_MODEL. Any OpenRouter id works.
# DIRECTOR_MODEL=google/gemini-2.5-flash
# Print each creator-mode render's filtergraph to the server log.
# CLIPPER_DEBUG_GRAPH=1

# Stock media for cutaways (Create desk). Either key may be absent; search uses the ones that exist.
# https://www.pexels.com/api/  ·  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
